<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="22dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/dn_time"
    android:layout_width="44dp" android:layout_height="wrap_content"
    android:textSize="14sp" android:textColor="@color/dn_secondary" />
  <ImageView android:id="@+id/dn_dot"
    android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dn_dot" />
  <TextView android:id="@+id/dn_title"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_marginStart="10dp" android:singleLine="true" android:ellipsize="end"
    android:textSize="14sp" android:textColor="@color/dn_primary" />
</LinearLayout>
