<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="20dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/dn_pill"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp"
    android:paddingStart="6dp" android:paddingEnd="6dp" android:background="@drawable/dn_bg_pill"
    android:text="RDV" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/dn_secondary" />
  <TextView android:id="@+id/dn_title"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:singleLine="true" android:ellipsize="end"
    android:textSize="13sp" android:textColor="@color/dn_primary" />
  <TextView android:id="@+id/dn_when"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
    android:textSize="12sp" android:textColor="@color/dn_late" />
</LinearLayout>
