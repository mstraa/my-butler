<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginBottom="4dp" android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp"
  android:background="@drawable/dn_bg_bday">
  <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/dn_ic_cake" />
  <TextView android:id="@+id/dn_text"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_marginStart="10dp" android:singleLine="true" android:ellipsize="end"
    android:textSize="13sp" android:textColor="@color/dn_primary" />
</LinearLayout>
