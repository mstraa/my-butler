<?xml version="1.0" encoding="utf-8"?>
<!-- « Ma journée » dépliée (maquette HF-Notifications) : anniversaires, rendez-vous du jour, retards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical">
  <LinearLayout android:id="@+id/dn_bdays"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="8dp" />
  <TextView android:id="@+id/dn_rdv_label"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.04" android:textAllCaps="true"
    android:textColor="@color/dn_secondary" android:layout_marginBottom="4dp" />
  <LinearLayout android:id="@+id/dn_rdv"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" />
  <TextView android:id="@+id/dn_empty"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="13sp" android:textColor="@color/dn_secondary" android:text="Rien de prévu aujourd'hui" />
  <LinearLayout android:id="@+id/dn_late_box"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@drawable/dn_bg_late">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
      <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/dn_ic_warning" />
      <TextView android:id="@+id/dn_late_label"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.04" android:textAllCaps="true"
        android:textColor="@color/dn_late" />
    </LinearLayout>
    <LinearLayout android:id="@+id/dn_late"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" />
  </LinearLayout>
</LinearLayout>
